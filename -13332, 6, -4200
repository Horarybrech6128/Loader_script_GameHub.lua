local autoRaceSwitch = nil

autoRaceSwitch = tabs.race:AddSwitch("Iniciar Auto Carrera", function(state)
    CONFIG.Running = state
    
    if state then
        task.spawn(function()
            while CONFIG.Running do
                local character, rootPart, humanoid = getCharacterParts()
                local gym = workspace:FindFirstChild("StrongbloxianGym")
                
                if rootPart and humanoid and gym then
                    -- Disable collisions on lane dividers
                    if gym:FindFirstChild("LaneDividers") then
                        for _, dividerPart in ipairs(gym.LaneDividers:GetDescendants()) do
                            if dividerPart:IsA("BasePart") then dividerPart.CanCollide = false end
                        end
                    end
                    
                    -- Activar Muro Invisible y Monitor de Pasos al iniciar ciclo
                    spawnInvisibleWall()
                    startWallMonitor()
                    
                    -- PHASE 1: QUEUE ZONE
                    tabs.race.StatusLabel.Text = "Estado: Yendo a QueueZone..."
                    local queueZone = gym:FindFirstChild("Lobby") 
                                  and gym.Lobby:FindFirstChild("Markers") 
                                  and gym.Lobby.Markers:FindFirstChild("QueueZone")
                                  
                    if queueZone then
                        teleportTo(queueZone.CFrame + Vector3.new(0, 3, 0))
                    end
                    
                    tabs.race.StatusLabel.Text = "Estado: Esperando asignación de carril..."
                    if not waitCancelable(4) then break end
                    
                    -- PHASE 2: LANE DETECTION & IMMEDIATE START
                    local course = gym:FindFirstChild("Course")
                    local lanes = course and course:FindFirstChild("Lanes")
                    local finishGate = course and course:FindFirstChild("FinishGate")
                    
                    if lanes then
                        local assignedLane = getClosestLane(lanes, rootPart)
                        if assignedLane then
                            tabs.race.LaneLabel.Text = "Carril Detectado: " .. assignedLane.Name
                            local segments = assignedLane:FindFirstChild("Segments")
                            
                            if segments then
                                local sledSegment = getTargetPart(segments:FindFirstChild("02_HeavySled"))
                                local liftSegment = getTargetPart(segments:FindFirstChild("03_HeavyLift"))
                                local wrestleSegment = getTargetPart(segments:FindFirstChild("04_ArmWrestle"))
                                local fallbackFinish = getTargetPart(finishGate)
                                
                                if liftSegment and wrestleSegment then
                                    local laneNumber = tonumber(string.match(assignedLane.Name, "%d+")) or 1
                                    local exactTargetPosition = CONFIG.LaneCoordinates[laneNumber]
                                    local exactFinishPosition = CONFIG.FinishCoordinates[laneNumber] or (fallbackFinish and fallbackFinish.Position)
                                    
                                    -- PHASE 3: TELEPORT TO EXACT SECTION 1 END
                                    tabs.race.StatusLabel.Text = "Estado: TP Sección 1 (" .. assignedLane.Name .. ")..."
                                    humanoid.PlatformStand = true
                                    
                                    if exactTargetPosition then
                                        teleportTo(CFrame.new(exactTargetPosition))
                                    elseif sledSegment then
                                        teleportTo(sledSegment.CFrame + Vector3.new(0, 3, 0))
                                    end
                                    
                                    task.wait(0.2)
                                    humanoid.PlatformStand = false
                                    
                                    -- 5-SECOND WAIT AT END OF SECTION 1
                                    for i = CONFIG.SectionWaitTime, 1, -1 do
                                        if not CONFIG.Running then break end
                                        tabs.race.StatusLabel.Text = "Estado: Sección 1 Finalizada (Pausa " .. i .. "s)..."
                                        task.wait(1)
                                    end
                                    if not CONFIG.Running then break end
                                    
                                    -- PHASE 4: DRAG SLED TO WEIGHT LIFT
                                    tabs.race.StatusLabel.Text = "Estado: Arrastrando Trineo..."
                                    humanoid.WalkSpeed = CONFIG.DefaultWalkSpeed
                                    task.wait(0.5)
                                    walkTo(liftSegment.Position)
                                    
                                    if not CONFIG.Running then break end
                                    
                                    -- START CONTINUOUS CLICKS (FROM WEIGHT LIFT UNTIL FINISH)
                                    local isClickingActive = true
                                    task.spawn(function()
                                        local clickInterval = 1 / CONFIG.TargetCPS
                                        while CONFIG.Running and isClickingActive do
                                            simulateClick()
                                            task.wait(math.max(0.01, clickInterval - 0.01))
                                        end
                                    end)
                                    
                                    -- PHASE 5: WEIGHT LIFTING
                                    tabs.race.StatusLabel.Text = "Estado: Levantando Pesa (Clics continuos)..."
                                    humanoid.WalkSpeed = CONFIG.LiftWalkSpeed
                                    teleportTo(liftSegment.CFrame + Vector3.new(0, 3, 0))
                                    task.wait(0.2)
                                    walkTo(wrestleSegment.Position)
                                    
                                    -- PHASE 6: ARM WRESTLE
                                    if CONFIG.Running then
                                        tabs.race.StatusLabel.Text = "Estado: Compitiendo en Pulso (Clics continuos)..."
                                        teleportTo(wrestleSegment.CFrame + Vector3.new(0, 3, 0))
                                        task.wait(0.2)
                                    end
                                    
                                    -- PHASE 7: FINAL SPRINT TO FINISH LINE
                                    if CONFIG.Running then
                                        tabs.race.StatusLabel.Text = "Estado: ¡Sprint Final a Meta (Clics continuos)!"
                                        humanoid.WalkSpeed = CONFIG.SprintWalkSpeed
                                        if exactFinishPosition then
                                            walkTo(exactFinishPosition)
                                        end
                                    end
                                    
                                    -- STOP CONTINUOUS CLICKS AFTER CROSSING FINISH
                                    isClickingActive = false
                                    removeInvisibleWall()
                                    
                                    tabs.race.StatusLabel.Text = "Estado: ¡Carrera Completada! Reiniciando ciclo..."
                                    resetWalkSpeed()
                                    task.wait(2)
                                end
                            end
                        else
                            tabs.race.LaneLabel.Text = "Carril Detectado: Fuera de la pista"
                        end
                    end
                end
                if not waitCancelable(2) then break end
            end
            
            removeInvisibleWall()
            resetWalkSpeed()
            tabs.race.StatusLabel.Text = "Estado: Inactivo"
            tabs.race.LaneLabel.Text = "Carril Detectado: Ninguno"
        end)
    else
        removeInvisibleWall()
        resetWalkSpeed()
        tabs.race.StatusLabel.Text = "Estado: Inactivo"
        tabs.race.LaneLabel.Text = "Carril Detectado: Ninguno"
    end
end)

