-- ==========================================
-- HELPER FUNCTIONS (MOVEMENT & CHARACTER)
-- ==========================================
local function getCharacterParts()
    local character = localPlayer.Character
    if not character then return nil, nil, nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if rootPart and humanoid and humanoid.Health > 0 then
        return character, rootPart, humanoid
    end
    return nil, nil, nil
end

local function teleportTo(targetCFrame)
    local _, rootPart = getCharacterParts()
    if rootPart then
        rootPart.CFrame = targetCFrame
    end
end

local function resetWalkSpeed()
    local _, _, humanoid = getCharacterParts()
    if humanoid then
        humanoid.WalkSpeed = CONFIG.DefaultWalkSpeed
        humanoid.PlatformStand = false
    end
end

local function waitCancelable(seconds)
    local elapsed = 0
    while elapsed < seconds do
        if not CONFIG.Running then return false end
        task.wait(0.05)
        elapsed = elapsed + 0.05
    end
    return true
end

local function getTargetPart(segment)
    if not segment then return nil end
    if segment:IsA("BasePart") then return segment end
    local hitPart = segment:FindFirstChild("Hitbox") or segment:FindFirstChild("TouchPart") or segment.PrimaryPart
    if hitPart then return hitPart end
    for _, child in ipairs(segment:GetDescendants()) do
        if child:IsA("BasePart") then 
            return child 
        end
    end
    return nil
end

local function walkTo(targetPosition)
    local _, rootPart, humanoid = getCharacterParts()
    if not rootPart or not humanoid then return end
    
    for _, velocityObj in ipairs(rootPart:GetChildren()) do
        if velocityObj:IsA("BodyVelocity") or velocityObj:IsA("BodyGyro") or velocityObj:IsA("LinearVelocity") then 
            velocityObj:Destroy() 
        end
    end
    humanoid.PlatformStand = false
    
    while CONFIG.Running do
        local _, currentRoot, currentHumanoid = getCharacterParts()
        if not currentRoot or not currentHumanoid then break end
        
        local currentPosition = currentRoot.Position
        local distance = (Vector3.new(targetPosition.X, 0, targetPosition.Z) - Vector3.new(currentPosition.X, 0, currentPosition.Z)).Magnitude
        if distance < 4 then break end 
        
        currentHumanoid:MoveTo(targetPosition)
        task.wait(0.1)
    end
    
    local _, _, finalHumanoid = getCharacterParts()
    if finalHumanoid then
        finalHumanoid:Move(Vector3.zero)
    end
end

local function getClosestLane(lanesFolder, rootPart)
    local closestLane = nil
    local minDistance = math.huge
    for _, lane in ipairs(lanesFolder:GetChildren()) do
        local segments = lane:FindFirstChild("Segments")
        if segments then
            local startSegment = segments:FindFirstChild("01_AgilityDash")
            local targetPart = getTargetPart(startSegment)
            if targetPart then
                local distance = (rootPart.Position - targetPart.Position).Magnitude
                if distance < minDistance then
                    minDistance = distance
                    closestLane = lane
                end
            end
        end
    end
    return closestLane
end

-- ==========================================
-- GESTOR DE MURO INVISIBLE E INTERRUPTOR POR 2º PASO
-- ==========================================
local globalWallPart = nil
local wallPassesCount = 0
local isMonitoringWall = false

local function spawnInvisibleWall()
    if globalWallPart and globalWallPart.Parent then
        globalWallPart.CanCollide = true
        return
    end
    
    local wall = Instance.new("Part")
    wall.Name = "ProyectadosInvisibleWall"
    wall.Size = CONFIG.WallSize
    wall.CFrame = CFrame.new(CONFIG.WallPosition)
    wall.Anchored = true
    wall.CanCollide = true
    wall.Transparency = 1
    wall.Parent = workspace

    globalWallPart = wall
    wallPassesCount = 0
end

local function removeInvisibleWall()
    if globalWallPart then
        globalWallPart.CanCollide = false
        globalWallPart:Destroy()
        globalWallPart = nil
    end
    wallPassesCount = 0
    isMonitoringWall = false
end

local function startWallMonitor()
    if isMonitoringWall then return end
    isMonitoringWall = true

    task.spawn(function()
        local insideZone = false

        while CONFIG.Running and globalWallPart and isMonitoringWall do
            local _, rootPart = getCharacterParts()
            if rootPart then
                local currentX = rootPart.Position.X
                local xDistance = math.abs(currentX - CONFIG.WallTriggerX)

                -- Detecta entrada al margen de 8 studs de X = -13500
                if xDistance <= 8 and not insideZone then
                    insideZone = true
                    wallPassesCount = wallPassesCount + 1
                    tabs.race.StatusLabel.Text = "Estado: Punto -13500 tocado (" .. wallPassesCount .. "/2)..."

                    if wallPassesCount >= 2 then
                        removeInvisibleWall()
                        tabs.race.StatusLabel.Text = "Estado: Muro desactivado tras el 2º paso."
                        break
                    end
                elseif xDistance > 14 and insideZone then
                    insideZone = false -- Permite registrar el segundo paso al volver a entrar
                end
            end
            task.wait(0.1)
        end
        isMonitoringWall = false
    end)
end

-- ==========================================
-- SCREEN CLICK SIMULATION
-- ==========================================
local function simulateClick()
    local camera = workspace.CurrentCamera
    if not camera then return end
    
    local viewportSize = camera.ViewportSize
    local centerX = math.floor(viewportSize.X / 2)
    local centerY = math.floor(viewportSize.Y / 2)

    pcall(function()
        virtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
    end)
    task.wait(0.01)
    pcall(function()
        virtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
    end)
end

