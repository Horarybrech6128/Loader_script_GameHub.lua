-- ==========================================
-- HELPERS
-- ==========================================
local function getChar()
    local char = lp.Character
    if not char then return nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return char, hrp, hum
    end
    return nil, nil, nil
end

local function tp(target)
    local _, hrp = getChar()
    if hrp then
        hrp.CFrame = target
    end
end

local function resetSpeed()
    local _, _, hum = getChar()
    if hum then
        hum.WalkSpeed = CFG.normalSpeed
        hum.PlatformStand = false
    end
end

local function pause(sec)
    local t = 0
    while t < sec do
        if not CFG.active then return false end
        task.wait(0.05)
        t = t + 0.05
    end
    return true
end

local function getPart(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    local hit = inst:FindFirstChild("Hitbox") or inst:FindFirstChild("TouchPart") or inst.PrimaryPart
    if hit then return hit end
    for _, obj in ipairs(inst:GetDescendants()) do
        if obj:IsA("BasePart") then 
            return obj 
        end
    end
    return nil
end

local function moveTo(pos)
    local _, hrp, hum = getChar()
    if not hrp or not hum then return end
    
    for _, v in ipairs(hrp:GetChildren()) do
        if v:IsA("BodyVelocity") or v:IsA("BodyGyro") or v:IsA("LinearVelocity") then 
            v:Destroy() 
        end
    end
    hum.PlatformStand = false
    
    while CFG.active do
        local _, curHrp, curHum = getChar()
        if not curHrp or not curHum then break end
        
        local curPos = curHrp.Position
        local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(curPos.X, 0, curPos.Z)).Magnitude
        if dist < 4 then break end 
        
        curHum:MoveTo(pos)
        task.wait(0.1)
    end
    
    local _, _, endHum = getChar()
    if endHum then
        endHum:Move(Vector3.zero)
    end
end

local function getLane(folder, hrp)
    local bestLane = nil
    local minDist = math.huge
    for _, lane in ipairs(folder:GetChildren()) do
        local segs = lane:FindFirstChild("Segments")
        if segs then
            local startSeg = segs:FindFirstChild("01_AgilityDash")
            local targetPart = getPart(startSeg)
            if targetPart then
                local dist = (hrp.Position - targetPart.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    bestLane = lane
                end
            end
        end
    end
    return bestLane
end

-- ==========================================
-- WALL SYSTEM
-- ==========================================
local wallObj = nil
local passCount = 0
local wallChecking = false

local function createWall()
    if wallObj and wallObj.Parent then
        wallObj.CanCollide = true
        return
    end
    
    local wall = Instance.new("Part")
    wall.Name = "ProyectadosInvisibleWall"
    wall.Size = CFG.wallSize
    wall.CFrame = CFrame.new(CFG.wallPos)
    wall.Anchored = true
    wall.CanCollide = true
    wall.Transparency = 1
    wall.Parent = ws

    wallObj = wall
    passCount = 0
end

local function clearWall()
    if wallObj then
        wallObj.CanCollide = false
        wallObj:Destroy()
        wallObj = nil
    end
    passCount = 0
    wallChecking = false
end

local function checkWall()
    if wallChecking then return end
    wallChecking = true

    task.spawn(function()
        local inZone = false

        while CFG.active and wallObj and wallChecking do
            local _, hrp = getChar()
            if hrp then
                local curX = hrp.Position.X
                local dist = math.abs(curX - CFG.wallX)

                if dist <= 8 and not inZone then
                    inZone = true
                    passCount = passCount + 1
                    tabs.race.StatusLabel.Text = "Estado: Punto -13500 tocado (" .. passCount .. "/2)..."

                    if passCount >= 2 then
                        clearWall()
                        tabs.race.StatusLabel.Text = "Estado: Muro desactivado tras el 2º paso."
                        break
                    end
                elseif dist > 14 and inZone then
                    inZone = false
                end
            end
            task.wait(0.1)
        end
        wallChecking = false
    end)
end

